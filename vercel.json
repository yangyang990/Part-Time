{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__path=/api/:path*" },
    { "source": "/files/:path*", "destination": "/api?__path=/files/:path*" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  }
}
